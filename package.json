{
  "name": "@ofzza/TSschema",
  "version": "0.0.1",
  "description": "Helps generate TS data models, provides TS utility types for deep type inference and provides TS runtime utilities for type reflection, all based off of a JSON schema",
  "homepage": "https://github.com/ofzza/TSschema#readme",
  "bugs": {
    "url": "https://github.com/ofzza/TSschema/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ofzza/TSschema.git"
  },
  "license": "MIT",
  "author": "ofzza",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "ci": "npm-run-all ci:*",
    "ci:build": "tsc",
    "ci:eslint": "eslint src",
    "ci:prettier": "prettier --check src",
    "ci:test-unit": "npm-run-all test:unit",
    "test": "npm-run-all test:*",
    "test:unit": "vitest run --passWithNoTests --project unit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/json-schema": "^7.0.15",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.1",
    "@ofzza/TSstd": "https://github.com/ofzza/TSstd.git#master"
  }
}
