{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "dist",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/*.ts", "src/**/*.ts", "src/*.json", "src/**/*.json"],
  "exclude": ["src/__legacy", "src/*.spec.ts", "src/**/*.spec.ts", "src/*.test.ts", "src/**/*.test.ts", "node_modules", "dist", "vite.config.ts"]
}
