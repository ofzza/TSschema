{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/*.ts", "src/**/*.ts", "src/*.tsx", "src/**/*.tsx", "src/*.json", "src/**/*.json"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test-d.ts",
    "src/**/*.test-d.tsx",
    "src/**/*.spec-d.ts",
    "src/**/*.spec-d.tsx",
    "node_modules",
    "dist",
    "vite.config.ts"
  ]
}
