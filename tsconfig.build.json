{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/*.ts", "src/**/*.ts", "src/*.json", "src/**/*.json"],
  "exclude": ["src/*.spec.ts", "src/**/*.spec.ts", "src/*.test.ts", "src/**/*.test.ts", "node_modules", "dist", "vite.config.ts"]
}
